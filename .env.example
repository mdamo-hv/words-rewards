# Required unless you run with --mock.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (all have sensible defaults).
# WR_MODEL=claude-opus-5            # default for all three stages
# WR_SOURCING_MODEL=claude-opus-5   # agent that picks the word
# WR_EXPLAINER_MODEL=claude-opus-5  # model under test
# WR_JUDGE_MODEL=claude-opus-5      # LLM-as-a-judge
# WR_SOURCING_EFFORT=low
# WR_EXPLAINER_EFFORT=medium
# WR_JUDGE_EFFORT=high
# WR_PASS_THRESHOLD=0.7
# WR_MAX_SENSES=6
# WR_OUTPUT_DIR=results
